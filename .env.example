# ==========================================
# RIDERS PATH — ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# A. PUBLIC FRONTEND VARIABLES (Browser-Safe)
# Exposed to the Vite client via import.meta.env.
# Safe to use in browser code with Supabase Row Level Security (RLS) enabled.
# ------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ------------------------------------------
# B. SERVER-ONLY VARIABLES (Private / Secret)
# Used exclusively by the Express server (server/*).
# NEVER prefix secret keys with VITE_ or expose them in frontend code.
# ------------------------------------------

# 1. Supabase Server Configuration
# SUPABASE_URL and SUPABASE_ANON_KEY are optional if VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are set.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Optional privileged key for server-side admin verification and non-destructive seeding:
SUPABASE_SERVICE_ROLE_KEY=""

# 2. Gemini AI API Key (Required for AI Vision Document Verification)
# On AI Studio: automatically injected from your user secrets.
# On Vercel: Add this in Vercel Dashboard -> Project Settings -> Environment Variables.
GEMINI_API_KEY=""

# 3. Application URL & Supabase Auth Redirect Configuration
# Local development: set APP_URL to your actual running app URL (e.g. http://localhost:3000).
# Production: set APP_URL to your deployed production URL (e.g. https://your-project.vercel.app)
# and add both URLs to Supabase Dashboard -> Authentication -> URL Configuration.
# For 6-digit email OTP verification, configure the Supabase "Confirm signup" email template
# to include {{ .Token }} instead of {{ .ConfirmationURL }} (see supabase/EMAIL_OTP_SETUP.md).
APP_URL="http://localhost:3000"

# 4. Email Gateway (Optional - for dispatching real renter confirmation emails)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-campus-email@gmail.com"
# SMTP_PASS="your-app-password"
# RESEND_API_KEY="re_..."

# 5. WhatsApp Gateway (Optional - for automated direct WhatsApp dispatch)
# WHATSAPP_API_KEY=""
